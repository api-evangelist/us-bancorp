{
  "opencollection": "1.0.0",
  "info": {
    "name": "US Bank Corporate Account Information Accounts API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://api.usbank.com/oauth/authorize",
      "accessTokenUrl": "https://api.usbank.com/oauth/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Accounts",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Accounts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.usbank.com/v1/accounts",
            "headers": [
              {
                "name": "Correlation-ID",
                "value": ""
              },
              {
                "name": "Accept",
                "value": ""
              },
              {
                "name": "On-Behalf-Of",
                "value": ""
              }
            ]
          },
          "docs": "Get a list of deposit accounts for the authorized customer."
        }
      ]
    }
  ],
  "bundled": true
}